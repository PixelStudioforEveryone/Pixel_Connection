# Replace both placeholders before starting. Keep credentials out of source control.
listening-port=3478
listening-ip=0.0.0.0
listening-ip=::
realm=YOUR_DOMAIN
fingerprint
lt-cred-mech
user=YOUR_TURN_USER:YOUR_RANDOM_TURN_PASSWORD
min-port=49160
max-port=49200
no-cli
no-multicast-peers
user-quota=12
total-quota=48
no-tcp
no-tls
no-dtls
no-tcp-relay
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
# If IPv4 NAT is present, provide the actual public/local IPv4 mapping:
# external-ip=YOUR_PUBLIC_IPV4/YOUR_LOCAL_IPV4
# Current libjuice backend uses TURN UDP; TCP/TLS-only TURN is not supported.
