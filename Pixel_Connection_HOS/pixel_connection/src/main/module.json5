{
  "module": {
    "name": "pixel_connection",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "Pixel_connectionAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "routerMap": "$profile:router_map",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",
        "reason": "$string:documents_permission_reason",
        "usedScene": {
          "abilities": ["Pixel_connectionAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:download_permission_reason",
        "usedScene": {
          "abilities": ["Pixel_connectionAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DESKTOP_DIRECTORY",
        "reason": "$string:desktop_permission_reason",
        "usedScene": {
          "abilities": ["Pixel_connectionAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:clipboard_permission_reason",
        "usedScene": {
          "abilities": ["Pixel_connectionAbility"],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "Pixel_connectionAbility",
        "srcEntry": "./ets/pixel_connectionability/Pixel_connectionAbility.ets",
        "description": "$string:Pixel_connectionAbility_desc",
        "icon": "$media:pxc_app_icon",
        "label": "$string:Pixel_connectionAbility_label",
        "startWindowIcon": "$media:pxc_app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "Pixel_connectionBackupAbility",
        "srcEntry": "./ets/pixel_connectionbackupability/Pixel_connectionBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}
